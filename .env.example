# PulseFlow configuration reference.
# Every variable below has a working default; nothing here is required for local
# development. Contract of record: specs/001-platform-foundation/contracts/configuration.md

# --- Identity ---
# PULSEFLOW_SERVICE_NAME=pulseflow-api        # worker default: pulseflow-worker
# PULSEFLOW_VERSION=dev
# PULSEFLOW_ENVIRONMENT=local                 # local | ci | benchmark

# --- HTTP server ---
# PULSEFLOW_HTTP_PORT=8080                    # worker default: 8081; range 1-65535
# PULSEFLOW_SHUTDOWN_GRACE_PERIOD=30s         # > 0, <= 5m

# --- Logging ---
# PULSEFLOW_LOG_LEVEL=info                    # debug | info | warn | error

# --- Kafka ---
# PULSEFLOW_KAFKA_BROKERS=localhost:9092      # comma-separated host:port list

# --- ClickHouse ---
# PULSEFLOW_CLICKHOUSE_ADDR=localhost:9000    # native protocol
# PULSEFLOW_CLICKHOUSE_DATABASE=pulseflow
# PULSEFLOW_CLICKHOUSE_USER=default
# PULSEFLOW_CLICKHOUSE_PASSWORD=              # sensitive: masked in logs

# --- Redis ---
# PULSEFLOW_REDIS_ADDR=localhost:6379
# PULSEFLOW_REDIS_PASSWORD=                   # sensitive: masked in logs

# --- Health checking ---
# PULSEFLOW_HEALTH_CHECK_TIMEOUT=2s           # > 0, <= 30s
# PULSEFLOW_HEALTH_CACHE_TTL=1s               # >= 0, strictly < HEALTH_CHECK_TIMEOUT
